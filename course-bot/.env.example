# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=111111111

# Prodamus: адрес вашей платёжной формы и секретный ключ (Настройки → Секретный ключ)
PRODAMUS_URL=https://yourshop.payform.ru
PRODAMUS_SECRET=
# 1 — подписывать ссылки на оплату (если в Prodamus включена проверка подписи ссылок)
PRODAMUS_SIGN_LINKS=0

# Публичный HTTPS-адрес сервера, куда Prodamus будет слать уведомления об оплате
PUBLIC_URL=https://bot.example.com
WEB_HOST=0.0.0.0
WEB_PORT=8080
